{
  "name": "hoodfees",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "check:public": "node scripts/check-public.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "build:worker": "vite build",
    "preview:worker": "node scripts/preview-worker.mjs",
    "deploy:worker": "node scripts/deploy-worker.mjs",
    "check:bundle": "node scripts/check-worker-bundle.mjs",
    "audit:deps": "node scripts/audit-deps.mjs",
    "verify:worker": "npm run check:public && npm test && npm run typecheck && npm run build:worker && npm run check:bundle && npm run audit:deps"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.56.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.2.1",
    "vite": "8.3.4",
    "wrangler": "4.151.1",
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261018.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "react-server-dom-webpack": "19.3.1",
    "braces": "file:vendor/braces"
  },
  "type": "module",
  "overrides": {
    "browserslist": "4.29.3",
    "fflate": "0.8.3",
    "js-yaml": "5.5.0",
    "braces": "$braces",
    "brace-expansion@<2": "1.1.21",
    "brace-expansion@>=3": "5.0.12",
    "undici": "7.30.1",
    "zod": "4.6.6",
    "fast-uri": "3.1.9"
  }
}
