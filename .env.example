# Optional server-only RPC provider. The app defaults to the public Robinhood RPC.
ROBINHOOD_RPC_URL=
# HMAC key for resumable scan cursors (at least 32 characters).
# With no key, local previews use a transient key; restart invalidates cursors.
SCAN_CURSOR_SECRET=
# Server-only key for O1 wallet-index discovery (never expose in browser config).
O1_API_KEY=
