# Server-only RPC provider. Required for production Workers hosting.
ROBINHOOD_RPC_URL=
# HMAC key for resumable scan cursors (at least 32 characters).
# Required for production. Keep it stable to preserve saved scan checkpoints.
SCAN_CURSOR_SECRET=
# Server-only key for O1 wallet-index discovery (never expose in browser config).
O1_API_KEY=
# Optional server-only bridge to verify checkpoints from the previous host.
LEGACY_PROGRESS_URL=
